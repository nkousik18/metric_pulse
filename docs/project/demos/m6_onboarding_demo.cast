[3.289134, "o", "Classifying 'superstore_sales_demo'...\r\n"]
[7.757027, "o", "\r\nProposed classification for superstore_sales_demo.csv (8399 rows, 21 columns):\r\n\r\n  Date column:   Order Date   (100.0% parse rate)\r\n  Grain:         other\r\n  Metrics:       Order Quantity, Sales, Discount, Profit, Unit Price, Shipping Cost, Product Base Margin\r\n  Dimensions:    Order Priority  (5 values, confidence 0.99 -- \"Very few distinct categorical values, not an identifier\")\r\n                 Ship Mode  (3 values, confidence 0.99 -- \"Low cardinality categorical field, suitable for grouping\")\r\n"]
[7.757203, "o", "                 Province  (13 values, confidence 0.98 -- \"Bounded set of region names, non‑identifier categorical\")\r\n                 Region  (8 values, confidence 0.98 -- \"Small set of region categories, appropriate dimension\")\r\n                 Customer Segment  (4 values, confidence 0.99 -- \"Few distinct business segments, categorical\")\r\n                 Product Category  (3 values, confidence 0.99 -- \"Very low cardinality product categories, suitable dimension\")\r\n                 Product Sub-Category  (17 values, confidence 0.95 -- \"Moderate number of sub‑categories, non‑identifier categorical\")\r\n                 Product Container  (7 values, confidence 0.98 -- \"Small set of container types, categorical\")\r\n  Rejected:      Row ID  (Identifier column (is_likely_id=True) with full cardinality)\r\n                 Order ID  (Likely identifier (high cardinality numeric) not suitable as metric or dimension)\r\n                 Customer Name  (High‑cardinality free‑text names, not appropriate as dimensio"]
[7.757241, "o", "n)\r\n                 Product Name  (High‑cardinality free‑text product descriptions, low date parse rate, not suitable as dimension)\r\n\r\n  [y] Confirm and proceed  [e] Edit a column's role  [n] Reject\r\n> "]
[7.757942, "o", "\r\nGenerating tables...\r\n"]
[7.869746, "o", "Confirmed. Generated tables at /Users/Masters/Projects/metric_pulse/onboarding/generated/superstore_sales_demo/superstore_sales_demo.duckdb\r\nReconciliation check passed.\r\n"]
[7.869832, "o", "\r\ndimension_config:\r\n{\r\n  \"Order Priority\": {\r\n    \"table\": \"metric_by_order_priority\",\r\n    \"segment_col\": \"order_priority\",\r\n    \"detail_col\": \"order_priority\"\r\n  },\r\n  \"Ship Mode\": {\r\n    \"table\": \"metric_by_ship_mode\",\r\n    \"segment_col\": \"ship_mode\",\r\n    \"detail_col\": \"ship_mode\"\r\n  },\r\n  \"Province\": {\r\n    \"table\": \"metric_by_province\",\r\n    \"segment_col\": \"province\",\r\n    \"detail_col\": \"province\"\r\n  },\r\n  \"Region\": {\r\n    \"table\": \"metric_by_region\",\r\n    \"segment_col\": \"region\",\r\n    \"detail_col\": \"region\"\r\n  },\r\n  \"Customer Segment\": {\r\n    \"table\": \"metric_by_customer_segment\",\r\n    \"segment_col\": \"customer_segment\",\r\n    \"detail_col\": \"customer_segment\"\r\n  },\r\n  \"Product Category\": {\r\n    \"table\": \"metric_by_product_category\",\r\n    \"segment_col\": \"product_category\",\r\n    \"detail_col\": \"product_category\"\r\n  },\r\n  \"Product Sub-Category\": {\r\n    \"table\": \"metric_by_product_sub_category\",\r\n    \"segment_col\": \"product_sub_category\",\r\n    \"detail_col\": \"product_sub_category\"\r\n  },\r\n  \"Product Container\""]
[7.869847, "o", ": {\r\n    \"table\": \"metric_by_product_container\",\r\n    \"segment_col\": \"product_container\",\r\n    \"detail_col\": \"product_container\"\r\n  }\r\n}\r\n\r\nReady to investigate -- try:\r\n  python -m onboarding.investigate --dataset-id superstore_sales_demo --metric order_quantity\r\n  python -m onboarding.investigate --dataset-id superstore_sales_demo --metric order_quantity --run-investigation\r\n"]
[7.978788, "o", "\r\n"]
