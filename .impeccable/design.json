  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-filled main action (Contact on LinkedIn, Investigate, Approve).",
      "html": "<button class=\"ds-btn ds-btn-primary\">Investigate with AI agent</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-ui);font-size:13px;font-weight:550;line-height:1;padding:9px 14px;border-radius:8px;border:1px solid transparent;cursor:pointer;transition:background-color 120ms cubic-bezier(0.16,1,0.3,1),border-color 120ms cubic-bezier(0.16,1,0.3,1),color 120ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-primary{background:var(--ink);color:var(--on-ink)}.ds-btn-primary:hover{background:var(--ink-2)}.ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined surface button (Approve with edits, Refresh).",
      "html": "<button class=\"ds-btn-secondary\">Approve with edits</button>",
      "css": ".ds-btn-secondary{font-family:var(--font-ui);font-size:13px;font-weight:550;line-height:1;padding:9px 14px;border-radius:8px;cursor:pointer;background:var(--surface);color:var(--ink);border:1px solid var(--border-strong);box-shadow:var(--shadow-sm);transition:background-color 120ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-secondary:hover{background:var(--surface-2)}.ds-btn-secondary:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Transparent low-emphasis action (Source, Look at another day, Copy).",
      "html": "<button class=\"ds-btn-quiet\">Look at another day</button>",
      "css": ".ds-btn-quiet{font-family:var(--font-ui);font-size:13px;font-weight:550;line-height:1;padding:9px 14px;border-radius:8px;border:1px solid transparent;cursor:pointer;background:transparent;color:var(--ink-2);transition:background-color 120ms cubic-bezier(0.16,1,0.3,1),color 120ms cubic-bezier(0.16,1,0.3,1)}.ds-btn-quiet:hover{background:var(--surface-2);color:var(--ink)}.ds-btn-quiet:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive action (Reject).",
      "html": "<button class=\"ds-btn-danger\">Reject</button>",
      "css": ".ds-btn-danger{font-family:var(--font-ui);font-size:13px;font-weight:550;line-height:1;padding:9px 14px;border-radius:8px;cursor:pointer;background:var(--surface);color:var(--fall);border:1px solid color-mix(in srgb,var(--fall) 45%,transparent)}.ds-btn-danger:hover{background:color-mix(in srgb,var(--fall) 8%,var(--surface))}.ds-btn-danger:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Tab Navigation",
      "kind": "nav",
      "refersTo": "nav-tab",
      "description": "Header tabs; active state is a quiet grey fill.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-tab is-active\">Overview</button><button class=\"ds-tab\">AI agents</button><button class=\"ds-tab\">How it's built</button><button class=\"ds-tab\">About</button></nav>",
      "css": ".ds-nav{display:flex;gap:2px}.ds-tab{border:0;background:transparent;cursor:pointer;font-family:var(--font-ui);font-size:13px;font-weight:500;color:var(--ink-3);padding:6px 10px;border-radius:6px;transition:color 120ms cubic-bezier(0.16,1,0.3,1),background-color 120ms cubic-bezier(0.16,1,0.3,1)}.ds-tab:hover,.ds-tab.is-active{color:var(--ink);background:var(--surface-2)}.ds-tab:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Text field and select.",
      "html": "<input class=\"ds-input\" placeholder=\"ACTION_APPROVER_TOKEN from .env\">",
      "css": ".ds-input{width:100%;font-family:var(--font-ui);font-size:13px;color:var(--ink);background:var(--surface);border:1px solid var(--border-strong);border-radius:8px;padding:8px 10px;min-height:36px}.ds-input:focus-visible{outline:2px solid var(--focus);outline-offset:1px}"
    },
    {
      "name": "Day Chip",
      "kind": "chip",
      "refersTo": "day-chip",
      "description": "Selectable flagged day; selected is a tinted fill, never a ring.",
      "html": "<button class=\"ds-day\" aria-pressed=\"true\"><strong>Sep 3, 2018 · revenue</strong><span>AI investigation recorded · labelled an event</span></button><button class=\"ds-day\" aria-pressed=\"false\"><strong>Aug 25, 2018 · orders</strong><span>labelled an event</span></button>",
      "css": ".ds-day{display:inline-flex;flex-direction:column;gap:1px;text-align:left;font-family:var(--font-ui);font-size:13px;cursor:pointer;padding:7px 12px;border-radius:8px;background:var(--surface);color:var(--ink);border:1px solid var(--border-strong);margin:0 8px 8px 0;transition:border-color 120ms cubic-bezier(0.16,1,0.3,1),background-color 120ms cubic-bezier(0.16,1,0.3,1)}.ds-day:hover{background:var(--surface-2)}.ds-day[aria-pressed=true]{background:var(--accent-soft);border-color:color-mix(in srgb,var(--accent) 55%,transparent)}.ds-day strong{font-weight:600;font-variant-numeric:tabular-nums}.ds-day span{font-size:12px;color:var(--ink-3)}.ds-day:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Metadata chips on approval cards: action type (mono), tier, next step.",
      "html": "<span class=\"ds-chip ds-chip-next\">Next recorded step: Approve</span> <span class=\"ds-chip ds-chip-strong\">notify_owner</span> <span class=\"ds-chip\">T1 · not reversible</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;font-family:var(--font-ui);font-size:12px;font-weight:500;color:var(--ink-2);background:var(--surface-2);border-radius:6px;padding:3px 8px}.ds-chip-strong{color:var(--ink);font-weight:600;font-family:var(--font-mono)}.ds-chip-next{color:var(--accent);background:var(--accent-soft);font-weight:600}"
    },
    {
      "name": "Tile",
      "kind": "card",
      "refersTo": "tile",
      "description": "Elevated white container for charts, breakdowns and approval cards.",
      "html": "<section class=\"ds-tile\"><h2>What drove the revenue change</h2><p>Each segment's share of the total change</p></section>",
      "css": ".ds-tile{background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-tile);padding:24px;font-family:var(--font-ui)}.ds-tile h2{margin:0 0 2px;font-size:17px;font-weight:600;line-height:1.3;letter-spacing:-0.01em;color:var(--ink)}.ds-tile p{margin:0;font-size:13px;color:var(--ink-3)}"
    },
    {
      "name": "Eval Score Row",
      "kind": "custom",
      "refersTo": "score-row",
      "description": "Eval figures with denominators, label and context.",
      "html": "<dl class=\"ds-scores\"><div><dd>25/30</dd><dt>Answers whose every claim checks out<span>runs · 83%</span></dt></div><div><dd>22/30</dd><dt>Names the expected root cause<span>runs · 73%</span></dt></div></dl>",
      "css": ".ds-scores{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:16px;margin:0;font-family:var(--font-ui)}.ds-scores div{display:flex;flex-direction:column;gap:2px}.ds-scores dd{margin:0;font-size:28px;font-weight:650;letter-spacing:-0.02em;line-height:1.1;color:var(--ink);font-variant-numeric:tabular-nums}.ds-scores dt{font-size:13px;color:var(--ink-2);line-height:1.4}.ds-scores dt span{display:block;font-size:12px;color:var(--ink-3)}"
    }
  ],
  "narrative": {
    "northStar": "The Category Standard",
    "overview": "A product UI built to Linear / Stripe Dashboard craft and not to a marketing-page template: cool neutral greys, white panels on a near-white canvas, near-black ink, one restrained blue accent, system type, hairline borders. The page stays quiet so the evidence (a 64px \"Revenue fell 90.6%\", the trend, the segment bars, eval figures with denominators) can carry the weight.\n\nThe density is moderate. Narrow reading pages (960px) use one column of stacked tiles. The single focal point on Overview is the answer headline, set at display size directly on the canvas with no card around it. Everything else sits in elevated white tiles or behind disclosures.\n\nWhere the build departs from the direction contract (`.impeccable/surfaces/templates-base-html.md`), the build is recorded here: the first viewport is one 960px column led by the answer headline, not a two-thirds anomaly panel with a one-third eval scorecard beside it; eval scores live on the AI agents tab, with a single proof line under the answer; tabs are Overview, AI agents, How it's built, About (not Investigate and Approvals); flagged days sit below the chart and breakdowns, not above the panel; the contribution view is per-dimension bars colored rise/fall, not a diverging-axis chart; the cited agent answer is one click away, not on the first screen.",
    "keyCharacteristics": [
