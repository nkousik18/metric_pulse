# AWS Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# S3
S3_BUCKET_NAME=metric-pulse-data

# Redshift
REDSHIFT_HOST=your-cluster.xxxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=your_password

# Alerting (docs/local-stack-scope.md §6.4). outbox = local Markdown files (default); sns = archived AWS
ALERT_CHANNEL=outbox
# OUTBOX_DIR=outbox
# ALERT_RECIPIENT=metric-pulse-alerts
# CloudWatch pipeline metrics (archived AWS); off unless true
CLOUDWATCH_METRICS=false

# SNS (archived; only used when ALERT_CHANNEL=sns)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:metric-pulse-alerts

# Detection
ANOMALY_THRESHOLD_ZSCORE=2.0
LOOKBACK_DAYS=30

# Investigation Agent (Phase 1 -- investigation/synthesize node)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# LangSmith tracing (docs/action-agent-scope.md §13.1) -- off unless LANGSMITH_TRACING=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=metricpulse

# Action Agent (local only)
ACTION_APPROVER=
